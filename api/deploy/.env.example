# Settings of the Portfolio.Api service, read by ASP.NET Core from the
# environment (double underscore = section separator, a list = indexed keys).
# Copy to .env on the server, chmod 600; nothing here is a secret today, but the
# file is the place of any future one, never appsettings.json.
PORTFOLIO__WORDPRESSBASEURL=https://morganvoltz.dev/wp-json/portfolio/v1/
# The origins the front may call from (a list: __0, __1...); Production refuses to start with none.
PORTFOLIO__ALLOWEDORIGINS__0=https://app.morganvoltz.dev
PORTFOLIO__CACHE__SITEMAPREFRESHSECONDS=60
