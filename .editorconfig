# EditorConfig — harmonise les conventions de formatage entre éditeurs
# Voir https://editorconfig.org pour la syntaxe complète
# Ce fichier est la source de vérité que Zed, JetBrains, VS Code et autres
# éditeurs respectent automatiquement (natif ou via plugin).

root = true

# ─── Convention par défaut pour tout fichier ─────────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ─── PHP : 4 espaces, PSR-12 ────────────────────────────
[*.php]
indent_size = 4

# ─── C# : 4 espaces, conventions Microsoft ──────────────
[*.{cs,csproj,sln}]
indent_size = 4

# ─── JavaScript, TypeScript, JSX, TSX : 2 espaces ───────
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

# ─── CSS, SCSS, Tailwind config : 2 espaces ─────────────
[*.{css,scss,sass,less}]
indent_size = 2

# ─── HTML : 2 espaces ───────────────────────────────────
[*.html]
indent_size = 2

# ─── JSON, YAML, TOML : 2 espaces ───────────────────────
[*.{json,yml,yaml,toml}]
indent_size = 2

# ─── Markdown : 2 espaces, conserver les espaces ────────
# Important : les espaces en fin de ligne en Markdown
# signifient un saut de ligne explicite (<br>), ne pas les trimmer
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# ─── Makefile : tabulations obligatoires (contrainte GNU Make) ─
[Makefile]
indent_style = tab

# ─── Shell scripts : 4 espaces ──────────────────────────
[*.{sh,bash,zsh}]
indent_size = 4

# ─── XML et dérivés ─────────────────────────────────────
[*.{xml,xsd,xsl}]
indent_size = 2
