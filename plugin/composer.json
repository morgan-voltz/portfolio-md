{
  "name": "morgan/portfolio-md",
  "description": "WordPress plugin that accepts Markdown as source and derives Gutenberg HTML, keeping the Markdown as source of truth.",
  "type": "wordpress-plugin",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "league/commonmark": "^2.5",
    "symfony/yaml": "^7.2",
    "scrivo/highlight.php": "^9.18"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Voltz\\PortfolioMd\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Voltz\\PortfolioMd\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
