
# .env.example — modèle de configuration pour l'environnement de développement local
#
# CE FICHIER EST COMMITTÉ DANS GIT.
# Il sert uniquement de modèle. Les valeurs ci-dessous sont des placeholders.
#
# Procédure :
#   1. Copier ce fichier en .env :     cp .env.example .env
#   2. Modifier les valeurs dans .env (ou les laisser, c'est du local)
#   3. Le fichier .env est dans .gitignore et ne sera jamais committé.
#
# Les vrais secrets (production, staging) ne sont JAMAIS dans Git.
# Ils sont gérés par le système de secrets de l'hébergeur.

# ─── Base de données ──────────────────────────────────
DB_ROOT_PASSWORD=changeme_root_password
DB_NAME=portfolio_wp
DB_USER=portfolio_user
DB_PASSWORD=changeme_user_password

# ─── WordPress (port d'exposition local) ──────────────
# Si tu as déjà quelque chose sur le port 8000, tu peux changer ici.
WP_PORT=8000

# ─── Identifiants admin WordPress ─────────────────────
# Utilisés par bootstrap.sh pour l'installation automatique.
# En local, des valeurs faibles sont acceptables.
# En staging/production, OBLIGATOIREMENT des valeurs fortes.
WP_ADMIN_USER=morgan
WP_ADMIN_PASSWORD=changeme_admin_password
WP_ADMIN_EMAIL=morgan@example.local

# ─── Métadonnées du site ──────────────────────────────
WP_SITE_TITLE="Voltz.dev — local"
WP_SITE_URL=http://localhost:8000
